# Copia este archivo a .env.local y completa los valores. Detalle en docs/platform.md.

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Dónde llegan los mensajes. Con el remitente de prueba, el email de tu cuenta de Resend.
CONTACT_TO_EMAIL=
# Opcional, al verificar un dominio en Resend. Por defecto: Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile, widget en modo Invisible: https://dash.cloudflare.com/?to=/:account/turnstile
# La clave del sitio se lee al compilar: tras cambiarla, vuelve a hacer el build.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
